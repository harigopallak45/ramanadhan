# Copy to .env and fill in. .env is gitignored, so it lives only on the machine
# it runs on — which means every value here has to be re-set by hand after a
# fresh clone, or a cPanel Node app being deleted and recreated.
#
# Two deployments are supported and differ ONLY in the three URL/mount vars
# below. Everything else is identical.
#
#   Local dev      backend serves the SPA at http://localhost:5001
#   cPanel         Passenger mounts this app under https://<domain>/audit
#
# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------
PORT=5001
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development                  # cPanel: production

# ---------------------------------------------------------------------------
# URLS AND MOUNT PATH — the three that differ between environments
# ---------------------------------------------------------------------------

# The sub-path Passenger mounts this app under, WITHOUT a trailing slash.
# cPanel does not strip its Application URL prefix before handing the request
# to Express, so '/audit/api/login' would otherwise match no route. Leave this
# empty for local dev, where the app is served from the root.
#   local:   (leave unset)
#   cPanel:  APP_BASE_PATH=/audit
APP_BASE_PATH=

# Public ORIGIN that emailed invite and password-reset links point at.
# Must be scheme + host only — NO path. Every caller appends its own path
# (e.g. `${FRONTEND_URL}/audit/reset`), so a value like
# 'https://example.com/auditapp/login' produces a link no route can match.
# Unset, links fall back to http://localhost:$PORT, which is right for dev
# and logged as a warning when NODE_ENV=production.
#   local:   (leave unset)
#   cPanel:  FRONTEND_URL=https://amlcompliance.com.au
FRONTEND_URL=

# Advertised to callers of /api/config. Cosmetic; nothing depends on it.
#   local:   BACKEND_URL=http://localhost:5001
#   cPanel:  BACKEND_URL=https://amlcompliance.com.au/audit
BACKEND_URL=http://localhost:5001

# Only for the retired split-deploy, where page routes lived on a separate
# host. Leave unset: when set, a missing frontend build redirects there
# instead of returning an honest 503.
LEGACY_FRONTEND_URL=

# ---------------------------------------------------------------------------
# GOHIGHLEVEL
# ---------------------------------------------------------------------------
GHL_API_KEY=
GHL_LOCATION_ID=

# Tags that decide who can sign in and who is an admin.
GHL_USER_TAG=audit user
GHL_ADMIN_TAG=audit admin

# Custom fields. Names are resolved to ids at boot, so these can stay as the
# field keys unless you want to pin actual ids.
GHL_PASSWORD_FIELD_ID=audit_password
GHL_RESET_URL_FIELD_ID=reset_password_url
GHL_ADMIN_MESSAGE_FIELD_ID=admin_message_to_client
GHL_INVITE_WEBHOOK_URL=
GHL_ADMIN_PORTAL_INVITE_LINK=

# Safety rails. The first caps contact pagination (100 per page); the second
# caps how many clients one dashboard progress-summary call will measure.
ADMIN_MAX_CONTACT_PAGES=50
ADMIN_SUMMARY_MAX_CLIENTS=250

# ---------------------------------------------------------------------------
# AI SCORING (rag-audit) — optional; without a key the AI features stay off
# and the dashboard shows "AI not set up".
# ---------------------------------------------------------------------------
# Step 1 — the primary engine every call goes to first.
LLM_PROVIDER=groq                     # groq | openai | anthropic | local
# Step 2 — backups, tried in order when the primary is down, rejects its
# key, is rate-limited for longer than LLM_FAILOVER_WAIT_MS, or returns a
# truncated / non-JSON answer. The SAME prompt is re-sent, so a report can
# finish on Claude when Groq drops mid-run. Leave unset to use every other
# provider that has a key (anthropic → openai → groq); set to an empty
# value to disable failover.
LLM_FALLBACK_PROVIDERS=anthropic,openai
# Request timeout. Unset = 60s for groq, 180s for the hosted frontier models.
LLM_TIMEOUT_MS=

GROQ_API_KEY=
GROQ_MODEL=
GROQ_MAX_TOKENS=

OPENAI_API_KEY=
OPENAI_MODEL=                         # default gpt-4o-mini
OPENAI_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                      # default claude-sonnet-5
ANTHROPIC_URL=
ANTHROPIC_VERSION=

LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

FULL_REPORT_MAX_TOKENS=
RAG_DOC_CHAR_BUDGET=
RAG_GROUND_CHARS=
RAG_SOURCES_FILE=
RAG_USE_WAYBACK=

# Reasoning models (gpt-oss, o-series, gpt-5) spend hidden reasoning tokens
# that count against max_tokens — capped at "low" so a 23-area score isn't
# truncated. "none" sends no reasoning parameter.
LLM_REASONING_EFFORT=low
# 429/5xx retries (the provider's retry-after is honoured when sent).
LLM_RETRY_MAX=4
LLM_RETRY_BASE_MS=15000
# With a backup configured the primary gets at most LLM_FAILOVER_RETRIES
# retries, and a retry-after longer than LLM_FAILOVER_WAIT_MS hands the
# call to the backup at once. An engine that failed on an outage-type
# error is rested for LLM_FAILOVER_COOLDOWN_MS (a rejected key: 30 min)
# so the rest of the run goes straight to the backup.
LLM_FAILOVER_RETRIES=2
LLM_FAILOVER_WAIT_MS=20000
LLM_FAILOVER_COOLDOWN_MS=300000
# Per-minute token cap the report writer sizes its prompts to. Learnt from
# the provider's response headers when unset (Groq free tier: 8000).
LLM_TPM_LIMIT=

# ---------------------------------------------------------------------------
# INDEPENDENT EXTERNAL REVIEW REPORT — sign-off details printed on the
# issued Word report (overridable per run from the auditor console).
# ---------------------------------------------------------------------------
REPORT_AUDITOR_NAME=Ramanathan Karuppiah
REPORT_AUDITOR_CREDENTIALS=MBA, CAMS-Audit, FIPA, FICA
REPORT_FIRM_NAME=Financial Crime Audits Pty Ltd
REPORT_BRAND_NAME=Centinl
# Output reservation per report stage and document-text budgets (upper
# bounds — scaled down automatically to fit the model's token cap).
REPORT_MAX_TOKENS=2300
REPORT_NARRATIVE_MAX_TOKENS=2500
REPORT_DOC_CHAR_BUDGET=14000
REPORT_PROFILE_CHAR_BUDGET=14000
REPORT_SECTIONS_PER_BATCH=6
# One "AI Score" run = score + report + Word + GHL filing, as a background job
# (2–10 minutes on a rate-limited key). Keep the Node process alive on the
# host (see DEPLOY.md) so a run finishes after the auditor leaves the page.
