# Copy to .env (local dev) or .env.production (a specific build) and set
# only if the default zero-config behaviour isn't right for your target:
#   - unset: `vite dev` on localhost talks to http://localhost:5001,
#            any other build talks to https://amlcompliance.com.au/hlgp
#   - set:   always talks to this URL, no matter where the build is served from
VITE_API_BASE_URL=https://amlcompliance.com.au/hlgp
